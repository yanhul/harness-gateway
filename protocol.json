{
  "protocol_version": 5,
  "authority_owner": "yanhul/AIOS",
  "gateway_role": "external_effect_boundary",
  "effect_contract": {
    "required": [
      "effect_id",
      "contract_id",
      "actor",
      "action",
      "capability_ref",
      "authority_ref",
      "evidence_ref",
      "lineage_ref",
      "idempotency_key"
    ],
    "owner": "AIOS",
    "gateway_may_bind": true,
    "gateway_may_create_authority": false
  },
  "commands": {
    "CREATE": {
      "args": [
        "ticket",
        "repository",
        "target_sha",
        "nonce",
        "ttl_seconds",
        "effect_contract"
      ],
      "effect": "create_ticket"
    },
    "SUA": {
      "args": [
        "ticket",
        "nonce",
        "sender",
        "target_sha"
      ],
      "effect": "authorize_one_repair"
    },
    "BOQUA": {
      "args": [
        "ticket",
        "sender"
      ],
      "effect": "reject_repair"
    },
    "RETRY": {
      "args": [
        "ticket",
        "sender"
      ],
      "effect": "retry_verification_only"
    },
    "BEGIN_EFFECT": {
      "args": [
        "ticket",
        "target_sha"
      ],
      "effect": "issue_bound_attempt"
    },
    "RECEIPT": {
      "args": [
        "ticket",
        "receipt"
      ],
      "effect": "record_bound_receipt"
    },
    "STATUS": {
      "args": [],
      "effect": "read_status"
    },
    "STOP": {
      "args": [
        "sender"
      ],
      "effect": "revoke_pending_and_authorized"
    },
    "RETRY_EFFECT": {
      "args": [
        "ticket",
        "retry_permit"
      ],
      "effect": "verify_aios_retry_permit_and_issue_next_fenced_attempt"
    }
  },
  "normalized_identity": {
    "effect_id": "AIOS effect identity",
    "attempt_id": "gateway execution attempt identity",
    "capability_ref": "AIOS capability reference",
    "authority_ref": "AIOS permit/authority reference",
    "evidence_ref": "pre-effect evidence reference",
    "lineage_ref": "AIOS lineage reference",
    "idempotency_key": "effect deduplication identity",
    "target_sha": "exact worker target revision",
    "retry_permit": "AIOS-signed, one-time, exact prior receipt/reconciliation-bound retry authority"
  },
  "authorization": {
    "sender_identity_required": true,
    "one_time_nonce_required_for_SUA": true,
    "nonce_must_match_ticket": true,
    "ticket_must_be_unexpired": true,
    "target_sha_must_match": true,
    "governance_digest_must_match": true,
    "replay_rejected": true,
    "effect_requires_authorized_ticket": true,
    "effect_requires_aios_contract": true,
    "receipt_must_bind_ticket_attempt_target_effect": true,
    "receipt_requires_evidence_and_lineage": true,
    "stop_revokes_pending_and_authorized": true,
    "begin_effect_is_idempotent": true,
    "replayed_begin_effect_may_execute": false,
    "attempt_and_receipt_history_durable": true,
    "receipt_evidence_and_lineage_must_match_contract": true,
    "retry_effect_requires_aios_ed25519_permit": true,
    "retry_permit_binds_prior_attempt_fence_and_receipt_digest": true,
    "retry_permit_requires_proven_not_submitted_reconciliation": true,
    "retry_permit_nonce_single_use": true,
    "retry_attempt_fence_strictly_increases": true,
    "retry_effect_replay_is_non_executable": true
  },
  "protected_governance": [
    "policy",
    "evidence_criteria",
    "promotion_criteria",
    "terminal_conditions",
    "trust_roots"
  ],
  "security_boundary": {
    "aios_owns_authority": true,
    "gateway_does_not_create_permits": true,
    "gateway_does_not_hold_github_credentials": true,
    "gateway_does_not_execute_shell_commands": true,
    "gateway_does_not_modify_repository_code": true,
    "worker_must_enforce_target_sha": true,
    "gateway_verifies_aios_retry_permit_public_key_only": true
  },
  "persistence": {
    "schema_version": 3,
    "atomic_snapshot_replace": true,
    "process_serialized_read_modify_write": true,
    "append_only_hash_chained_events": true,
    "attempt_history": true,
    "receipt_history": true,
    "legacy_v2_attempts_without_history": "fail_closed_reconciliation_required",
    "retry_permit_history": true,
    "consumed_retry_nonces": true
  }
}
